#!/bin/sh
# Shared pre-removal script: deb prerm, rpm %preun, apk .pre-deinstall.
#
# Argument semantics differ per package manager:
#   deb prerm:          $1 = "remove"|"purge" on removal, "upgrade <old> <new>"
#                      (plus "failed-upgrade"/"disappear" corner cases)
#   rpm %preun:         $1 = 0 on erase, 1 on upgrade
#   apk .pre-deinstall: $1 = "pre-deinstall", $2 = version (removal only;
#                      upgrades run .pre-upgrade, which this package does not ship)
#
# On upgrades we must NOT stop the service: the new package's postinst
# already restarted it, and rpm runs the old package's %preun afterwards.
set -e

SERVICE_NAME="pbs-plus-agent"
BIN_PATH="/opt/pbs-plus-agent/pbs-plus-agent"

is_upgrade() {
  case "$1" in
    upgrade*|failed-upgrade) return 0 ;;
    1) return 0 ;;
  esac
  return 1
}

if is_upgrade "$1"; then
  exit 0
fi

if [ -x "$BIN_PATH" ]; then
  "$BIN_PATH" stop 2>/dev/null || true
  "$BIN_PATH" uninstall 2>/dev/null || true
fi

# Belt and braces in case the binary could not run (e.g. broken install).
if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
  systemctl stop "$SERVICE_NAME" 2>/dev/null || true
  systemctl disable "$SERVICE_NAME" 2>/dev/null || true
  systemctl daemon-reload 2>/dev/null || true
fi

if command -v rc-update >/dev/null 2>&1; then
  rc-update del "$SERVICE_NAME" default 2>/dev/null || true
fi
rm -f "/etc/init.d/$SERVICE_NAME" 2>/dev/null || true

rm -f "/etc/systemd/system/$SERVICE_NAME.service" \
      "/usr/lib/systemd/system/$SERVICE_NAME.service" \
      "/lib/systemd/system/$SERVICE_NAME.service" 2>/dev/null || true

exit 0
