abi <abi/3.0>,

#include <tunables/global>

# attach_disconnected is required because the unit sets PrivateTmp=yes, which
# makes the journal socket a disconnected path inside the mount namespace.
/opt/pbs-plus-agent/pbs-plus-agent flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  # Allow binary execution and updates. ix is required because the agent
  # re-execs itself to fork per-job child processes (cli/exec_unix.go).
  /opt/pbs-plus-agent/pbs-plus-agent mrix,
  /opt/pbs-plus-agent/{,**} rwk,

  # Allow systemd control and unit file installation
  /bin/systemctl ix,
  /usr/bin/systemctl ix,
  /usr/bin/sudo ix,
  /etc/systemd/system/pbs-plus-agent.service rw,

  # State and config directories. The registry uses flock, so k is required.
  /var/lib/pbs-plus-agent/{,**} rwk,
  /var/log/pbs-plus-agent/{,**} rwk,
  /etc/pbs-plus-agent/{,**} rwk,

  # Parent->child handshake token files written by cli/backup.go,
  # cli/restore.go, and cli/verify.go; read and unlinked by cli/entry.go.
  /tmp/.pbs-plus-token-* rw,

  # Backup sources: the agent reads arbitrary paths on the host
  / r,
  /** r,

  # Network for updates, QUIC transport, and local resolver sockets
  unix,
  network unix stream,
  network unix dgram,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,

  # Capabilities needed
  capability dac_override,
  capability dac_read_search,
}
